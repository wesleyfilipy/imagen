# ─── OpenAI ────────────────────────────────────────────────
# Chave secreta (somente no servidor — NUNCA use prefixo NEXT_PUBLIC_)
OPENAI_API_KEY=
# Modelo de edição de imagem. gpt-image-1 foi desativado em 23/10/2026.
# Alternativas: gpt-image-2.5-sunburst, gpt-image-2.5-flare, gpt-image-1.5
OPENAI_IMAGE_MODEL=gpt-image-2
# Resolução final (largura x altura, múltiplos de 16). 1536x2304 = retrato 2:3 em alta resolução.
# Para gpt-image-1.5 use 1024x1536.
OPENAI_IMAGE_SIZE=1536x2304
OPENAI_IMAGE_QUALITY=high
# Somente para modelos que aceitam (ex.: gpt-image-1.5 → high). Deixe vazio para gpt-image-2.
OPENAI_INPUT_FIDELITY=

# ─── Lastlink ──────────────────────────────────────────────
# Link de checkout do produto de R$ 19,90 criado no painel da Lastlink
LASTLINK_CHECKOUT_URL=https://lastlink.com/p/C3AA92C82/checkout-payment/
# Use o "Token" que a Lastlink mostra na tela do webhook. Cadastre o webhook na Lastlink como:
#   https://SEU-DOMINIO/api/webhooks/lastlink?token=ESTE_TOKEN
LASTLINK_WEBHOOK_TOKEN=
# (Opcional) ID/código do produto. Se definido, só eventos que contenham esse valor liberam downloads.
LASTLINK_PRODUCT_ID=
# (Opcional, recomendado) Nomes exatos dos eventos de pagamento aprovado / estorno, separados por vírgula.
# Veja o nome real no log "[lastlink] evento recebido" após um webhook de teste.
LASTLINK_APPROVED_EVENTS=
LASTLINK_REFUND_EVENTS=
# Aceitar eventos marcados como teste? Mantenha false em produção.
LASTLINK_ACCEPT_TEST_EVENTS=false

# ─── App ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# (Opcional) String aleatória longa usada para hash de IP. Sem ela, é derivada da chave da OpenAI.
SESSION_SECRET=
# Segredo para forçar a limpeza via GET /api/cron/cleanup (Authorization: Bearer CRON_SECRET)
CRON_SECRET=
# Na Vercel: conecte um Blob Store (Storage → Blob) — cria BLOB_STORE_ID (ou BLOB_READ_WRITE_TOKEN) automaticamente.
# Fora da Vercel (sem Blob): pasta onde ficam o banco (db.json) e as fotos. Em produção aponte para um disco/volume persistente.
DATA_DIR=
# Dias até excluir automaticamente fotos originais, geradas e registros
RETENTION_DAYS=7
# Limites anti-abuso de geração (custo da OpenAI)
MAX_GENERATIONS_PER_IP_PER_DAY=4
MAX_GENERATIONS_PER_SESSION_PER_DAY=3
